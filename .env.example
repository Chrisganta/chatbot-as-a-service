# Base URL of an OpenAI-compatible chat completions endpoint (no trailing slash).
# For local dev with Ollama: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model name/tag as understood by the endpoint above.
LLM_MODEL=qwen3:4b-instruct

# Optional bearer key sent to the LLM endpoint (Ollama ignores this; required by
# most hosted providers like OpenRouter/Groq/Together).
LLM_API_KEY=

# Optional "user:pass" credential if LLM_BASE_URL is protected by HTTP Basic
# Auth (e.g. a dev tunnel like `ngrok http 11434 --basic-auth=user:pass`).
# Mutually exclusive with LLM_API_KEY — set one or the other, not both.
LLM_TUNNEL_AUTH=

# System prompt prepended to every conversation.
SYSTEM_PROMPT=You are a friendly, helpful assistant.

# Comma-separated list of origins allowed to call /api/chat via CORS.
# Use * to allow any origin (fine for a public demo; be deliberate in production).
ALLOWED_ORIGINS=*

# Optional comma-separated list of API keys. If set, external callers must send
# "Authorization: Bearer <key>". Leave empty to allow unauthenticated access
# (e.g. for the embeddable widget on your own site).
SERVICE_API_KEYS=

# Best-effort per-IP rate limit (requests/minute) for /api/chat. See lib/rateLimit.ts
# for caveats on serverless platforms.
RATE_LIMIT_PER_MINUTE=20
