# Base URL of an OpenAI-compatible chat completions endpoint (no trailing slash).
# For local dev with Ollama: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model name/tag as understood by the endpoint above.
LLM_MODEL=qwen3:4b-instruct

# Optional bearer key sent to the LLM endpoint (Ollama ignores this; required by
# most hosted providers like OpenRouter/Groq/Together).
LLM_API_KEY=

# Optional "user:pass" credential if LLM_BASE_URL is protected by HTTP Basic
# Auth (e.g. a dev tunnel like `ngrok http 11434 --basic-auth=user:pass`).
# Mutually exclusive with LLM_API_KEY — set one or the other, not both.
LLM_TUNNEL_AUTH=

# System prompt prepended to every conversation.
SYSTEM_PROMPT=You are a friendly, helpful assistant.

# Comma-separated list of origins allowed to call /api/chat via CORS.
# Use * to allow any origin (fine for a public demo; be deliberate in production).
ALLOWED_ORIGINS=*

# Optional comma-separated list of API keys/access codes. If set:
# - Programmatic callers must send "Authorization: Bearer <key>"
# - The chat UI (/ and /embed) shows an "enter access code" gate until one
#   of these codes is entered — give one out to whoever you want to let in.
# - Embeds on trusted sites can skip the gate entirely by adding
#   data-access-code="<key>" to the widget.js <script> tag. Note this value
#   is visible in the host page's source — prefer SESSION_SIGNING_SECRET +
#   EMBED_SERVER_KEYS below for embeds that need a non-static credential.
# Leave empty to allow fully open, unauthenticated access.
SERVICE_API_KEYS=

# Best-effort per-IP rate limit (requests/minute) for /api/chat. See lib/rateLimit.ts
# for caveats on serverless platforms.
RATE_LIMIT_PER_MINUTE=20

# --- Short-lived embed session tokens (/api/issue-session) ---
# An alternative to SERVICE_API_KEYS for embeds: the embedding host's OWN
# backend calls POST /api/issue-session with "Authorization: Bearer <key>"
# (one of EMBED_SERVER_KEYS below) to mint a token that expires in
# SESSION_TTL_MINUTES, then hands that token to its frontend (e.g. via a
# data-session-url endpoint consumed by widget.js). Unlike SERVICE_API_KEYS,
# these secrets are never sent to a browser.

# Comma-separated list of server-to-server secrets allowed to call
# /api/issue-session. Leave empty to disable session-token issuance.
EMBED_SERVER_KEYS=

# HMAC key used to sign/verify session tokens. Required for
# /api/issue-session to work at all — leave unset to disable it outright.
SESSION_SIGNING_SECRET=

# How long an issued session token stays valid.
SESSION_TTL_MINUTES=60
